{
	order rate_limit before reverse_proxy
}

:8091 {
	encode zstd gzip

	# Security headers (HAProxy handles TLS)
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://tile.openstreetmap.org https://*.tile.openstreetmap.org; font-src 'self' data:;"
		}

	@cors_origin {
		header Origin https://fswepp2.bearhive.duckdns.org
		header Origin https://fswepp2-dev.bearhive.duckdns.org
		header Origin http://localhost:5173
		header Origin http://localhost:8091
		header Origin http://127.0.0.1:5173
		header Origin http://127.0.0.1:8091
	}

	@cors_preflight {
		method OPTIONS
		header Origin https://fswepp2.bearhive.duckdns.org
		header Origin https://fswepp2-dev.bearhive.duckdns.org
		header Origin http://localhost:5173
		header Origin http://localhost:8091
		header Origin http://127.0.0.1:5173
		header Origin http://127.0.0.1:8091
	}

	handle_path /fswepp2/api/* {
		header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
		header @cors_origin Access-Control-Allow-Credentials "true"
		header @cors_origin Access-Control-Allow-Methods "GET,POST,OPTIONS"
		header @cors_origin Access-Control-Allow-Headers "Content-Type,Authorization,X-Request-Id"
		header @cors_origin Vary "Origin"
		respond @cors_preflight 204
		rate_limit {
			zone fswepp2_api {
				key {remote_host}
				events 300
				window 1m
			}
		}
		rewrite * /api{path}
		reverse_proxy api:8090
	}

	# HAProxy health check
	handle /health {
		respond "ok" 200
	}

	# Optional transitional alias
	handle_path /api/* {
		header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
		header @cors_origin Access-Control-Allow-Credentials "true"
		header @cors_origin Access-Control-Allow-Methods "GET,POST,OPTIONS"
		header @cors_origin Access-Control-Allow-Headers "Content-Type,Authorization,X-Request-Id"
		header @cors_origin Vary "Origin"
		respond @cors_preflight 204
		rate_limit {
			zone fswepp2_api_alias {
				key {remote_host}
				events 300
				window 1m
			}
		}
		rewrite * /api{path}
		reverse_proxy api:8090
	}

	# PRISM COG assets (range requests)
	handle_path /prism_data/* {
		header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
		header @cors_origin Access-Control-Allow-Credentials "true"
		header @cors_origin Access-Control-Allow-Methods "GET,HEAD,OPTIONS"
		header @cors_origin Access-Control-Allow-Headers "Content-Type,Authorization,X-Request-Id,Range"
		header @cors_origin Access-Control-Expose-Headers "Content-Range,Accept-Ranges,Content-Length"
		header @cors_origin Vary "Origin"
		respond @cors_preflight 204
		root * /srv/prism_data
		file_server
	}

	# Static assets (served by UI container)
	handle /public/* {
		reverse_proxy ui:5173
	}

	# App pages (FSWEPP2)
	handle /fswepp2* {
		reverse_proxy ui:5173
	}

	# Guard legacy namespace (served elsewhere during migration)
	handle /fswepp* {
		respond "legacy fswepp is not served by this stack" 404
	}

	# Root (reserved for later legacy/index backfill)
	handle {
		reverse_proxy ui:5173
	}
}
