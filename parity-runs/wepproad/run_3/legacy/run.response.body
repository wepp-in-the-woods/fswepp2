  function showslopefile() {
    var properties="menubar,scrollbars,resizable"
    filewindow = window.open("","file",properties)
    filewindow.document.open()
    if (filewindow && filewindow.open && !filewindow.closed) {
      filewindow.focus
      filewindow.document.writeln("<head><title>WEPP slope file wepp-1078<\/title><\/head>")
      filewindow.document.writeln("<body><font face='courier'><pre>")
      filewindow.document.writeln("97.3")
      filewindow.document.writeln("# Slope file for inbare by WEPP:Road Interface")
      filewindow.document.writeln("3")
      filewindow.document.writeln("100 3.96")
      filewindow.document.writeln("2  60.96")
      filewindow.document.writeln("0.00, 0.04  1.00, 0.04")
      filewindow.document.writeln("3  4.57")
      filewindow.document.writeln("0.00, 0.04  0.05, 0.50  1.00, 0.50")
      filewindow.document.writeln("3  39.62")
      filewindow.document.writeln("0.00, 0.50  0.05, 0.25  1.00, 0.25")
      filewindow.document.writeln("<\/pre><\/font><\/body><\/html>")
      filewindow.document.close()
    }
    return false
  }

