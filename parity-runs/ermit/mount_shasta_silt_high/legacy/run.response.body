  newinpt.document.writeln('     <td align=right><font size=1> 33.15</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 36.42</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>LHH (30%)  (25%)  (0%)  (0%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
  newinpt.document.writeln('    <tr>')
  newinpt.document.writeln('     <td align=right><font size=1>  4.19</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  7.48</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 19.44</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 28.84</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 32.72</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>HLH (30%)  (25%)  (25%)  (0%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
  newinpt.document.writeln('    <tr>')
  newinpt.document.writeln('     <td align=right><font size=1>  4.47</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  7.30</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 17.06</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 26.56</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 31.53</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>HHL (30%)  (25%)  (25%)  (25%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
