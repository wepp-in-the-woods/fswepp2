  var sed_del_max = rounder(sed_del[1]*js_sedconv,2)
  var default_sed_del = rounder((sed_del_max-sed_del_min)/2,2)

    sedval = document.doit.sediment0x.value
    if (!isNumber (sedval)) {sedval = default_sed_del}
