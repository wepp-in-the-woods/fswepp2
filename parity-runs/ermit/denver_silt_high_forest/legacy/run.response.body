  newinpt.document.writeln('     <td align=right><font size=1>  5.40</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  6.88</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1> 10.06</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>HHH (10%)  (0%)  (0%)  (0%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
  newinpt.document.writeln('    <tr>')
  newinpt.document.writeln('     <td align=right><font size=1>  0.84</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  1.89</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  2.75</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  4.53</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  8.49</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>LHH (30%)  (25%)  (0%)  (0%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
  newinpt.document.writeln('    <tr>')
  newinpt.document.writeln('     <td align=right><font size=1>  0.84</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  2.31</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  3.21</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  4.76</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  7.63</font></td>')
  newinpt.document.writeln('        <td bgcolor=#ccffff><font size=1>HLH (30%)  (25%)  (25%)  (0%)  (0%)</font></td>')
  newinpt.document.writeln('       </tr>')
  newinpt.document.writeln('    <tr>')
  newinpt.document.writeln('     <td align=right><font size=1>  0.79</font></td>')
  newinpt.document.writeln('     <td align=right><font size=1>  2.73</font></td>')
