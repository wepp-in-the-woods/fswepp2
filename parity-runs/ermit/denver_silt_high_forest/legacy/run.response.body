  newinpt.document.writeln(' </HEAD>')
  newinpt.document.writeln(' <body bgcolor="ivory" onLoad="top.window.focus()">')
  newinpt.document.writeln('  <font face="Tahoma, Arial, Helvetica, sans serif" size=-1>')
