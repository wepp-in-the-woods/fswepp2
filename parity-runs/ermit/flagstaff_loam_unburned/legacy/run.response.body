    if (var1[i] == var1[i-1]) {newin.document.writeln('     <td>&nbsp;<\/td>')} else {newin.document.writeln('     <td><font face="Tahoma, Arial, Helvetica, sans serif" size=1>' + rounder(var1[i]*100,2)+'<\/td>')}
