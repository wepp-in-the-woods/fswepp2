set terminal pngcairo size 800,600 enhanced font 'sans,10' fontscale 1.1
set output '../working/wepp-1256.png'
set title 'Sediment Delivery Exceedance Probability for unburned FLAGSTAFF WB AP AZ'
set xlabel 'Sediment Delivery (ton / ac)'
set ylabel 'Probability (%)'
set noautoscale y
set yrange [0:100]
set key top
set grid ytics
set grid xtics
set timestamp "%m-%d-%Y -- loam; 20%% rock; 0%%, 50%%, 30%% slope; 300 ft; unburned [wepp-1256]"
plot [] [1:] \
     '../working/wepp-1256.gnudata' using 1:2 t '1st year' with lines linewidth 3
