FROM oven/bun:1.1 AS base
WORKDIR /app

# Install Node.js for Playwright CLI usage
RUN apt-get update \
  && apt-get install -y curl ca-certificates gnupg \
  && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
  && apt-get install -y nodejs \
  && rm -rf /var/lib/apt/lists/*

# Keep Playwright browsers inside the image
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install deps
COPY ui/package.json ui/tsconfig.json ui/tailwind.config.ts ./
RUN bun install

# Install Playwright browsers + system deps once during image build
RUN npx playwright install --with-deps chromium

# Copy source
COPY ui/src ./src
COPY ui/styles ./styles
COPY ui/public ./public

RUN bun run build:css

EXPOSE 5173
CMD ["bun", "run", "dev"]
