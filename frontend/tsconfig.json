    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }

  },
  "include": ["src/**/*", "src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
