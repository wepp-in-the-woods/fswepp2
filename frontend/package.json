{
  "name": "fswepp2-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./public/app.css --watch",
    "dev:js": "bun build ./src/index.tsx --outdir ./public/js --target browser --watch",
    "dev": "bun run src/server.ts",
    "dev:all": "bun run dev:css & bun run dev:js & bun run dev",
    "build:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./public/app.css --minify",
    "build:js": "bun build ./src/index.tsx --outdir ./public/js --target browser --minify",
    "build": "bun run build:css && bun run build:js",
    "start": "PORT=${PORT:-5173} bun run src/server.ts",
    "test": "bun test --preload ./tests/setup.ts"
  },
  "dependencies": {
    "hono": "^4.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "axios": "^1.9.0",
    "lucide-react": "^0.511.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.6",
    "zod": "^3.25.71",
    "@hookform/resolvers": "^5.1.1",
    "react-hook-form": "^7.59.0",
    "react-leaflet": "^5.0.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "vaul": "^1.1.2",
    "convert-units": "^2.3.4",
    "cmdk": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "tw-animate-css": "^1.3.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "@happy-dom/global-registrator": "^15.10.2",
    "happy-dom": "^15.10.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^24.0.3",
    "@types/bun": "latest"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "module": "src/index.tsx"
}
